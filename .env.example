APP_NAME="Nexo GPS"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://gps.test
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gps_tracking
DB_USERNAME=gps_app
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_COOKIE=nexo_gps_session
SESSION_SECURE_COOKIE=false
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=nexo_gps
MAIL_MAILER=log
REVERB_APP_ID=gps-local
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8086
REVERB_HOST=127.0.0.1
REVERB_PORT=8086
REVERB_SCHEME=http
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1,gps.localhost,gps.test
VITE_APP_NAME="${APP_NAME}"
REVERB_CLIENT_HOST=localhost
REVERB_CLIENT_PORT=8086
REVERB_CLIENT_SCHEME=http
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
